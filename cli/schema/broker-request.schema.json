{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airoot.local/schema/broker-request-v1.json",
  "title": "AIROOT Protected Broker Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "operation", "client"],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "operation": { "type": "string", "enum": ["commit_plan", "recover_transaction", "probe_root", "gc_apply"] },
    "plan_ref": { "type": ["string", "null"], "pattern": "^(?:state/plans|state\\\\plans)(?:/|\\\\)[^\\0]+$" },
    "approval_ref": { "type": ["string", "null"], "pattern": "^(?:state/approvals|state\\\\approvals)(?:/|\\\\)[^\\0]+$" },
    "transaction_id": { "type": ["string", "null"] },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sid", "pid", "integrity", "application_id"],
      "properties": {
        "sid": { "type": "string", "pattern": "^S-1-[0-9-]+$" },
        "pid": { "type": "integer", "minimum": 1 },
        "integrity": { "type": "string", "enum": ["low", "medium", "high", "system"] },
        "application_id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "requested_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "commit_plan" } } },
      "then": { "required": ["plan_ref", "approval_ref"], "properties": { "plan_ref": { "type": "string" }, "approval_ref": { "type": "string" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "recover_transaction" } } },
      "then": { "required": ["transaction_id"], "properties": { "transaction_id": { "type": "string" } } }
    }
  ]
}
