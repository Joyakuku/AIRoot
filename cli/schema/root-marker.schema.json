{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airoot.local/schema/root-marker-v1.json",
  "title": "AIROOT Root Marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_instance_id", "protocol_version", "volume_serial", "canonical_path", "created_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "root_instance_id": { "$ref": "common.schema.json#/$defs/id" },
    "protocol_version": { "type": "integer", "const": 1 },
    "volume_serial": { "type": "string", "pattern": "^[A-Fa-f0-9-]{1,128}$" },
    "canonical_path": { "type": "string", "minLength": 3, "maxLength": 2048 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "application_generation": { "type": "integer", "minimum": 0 }
  }
}
